{
  "manifest_version": 3,
  "name": "CRM BY LEADSRIFT Activity Bridge",
  "version": "4.1.0",
  "description": "Tracks browser-wide activity for CRM BY LEADSRIFT auto logout system.",
  "permissions": ["storage", "tabs", "idle"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}